<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3A3A" />
    
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#333333" />
    
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#404040" />
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#1A1A1A" />
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="SecondaryHoverBorderBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SecondaryDisabledBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SecondaryDisabledBorderBrush" Color="#404040" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#E0E0E0" />
    
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerDisabledBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#1A1A1A" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#1A1A1A" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#808080" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#606060" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF" />
    
    <SolidColorBrush x:Key="FocusBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#60A5FA" />
    
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#2A4A6F" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFFFFF" />
    
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ProgressForegroundBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="ProgressCurrentForegroundBrush" Color="#4ADE80" />
    
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#4A4A4A" />
