    <SolidColorBrush x:Key="GroupBoxHeaderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#3A3A3A" />
    
    <SolidColorBrush x:Key="ListBoxBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ListBoxBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ListBoxItemHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBorderBrush" Color="#2A4A6F" />
    
    <SolidColorBrush x:Key="DropShadowBrush" Color="#33000000" />
    
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC000000" />
    
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
    
    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />

</ResourceDictionary>