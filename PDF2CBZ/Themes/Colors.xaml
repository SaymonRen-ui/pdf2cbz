<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Base Colors (referenced by themes) -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryHoverColor">#106EBE</Color>
    <Color x:Key="PrimaryPressedColor">#005A9E</Color>
    <Color x:Key="PrimaryDisabledColor">#CCCCCC</Color>
    
    <Color x:Key="DangerColor">#D13438</Color>
    <Color x:Key="DangerHoverColor">#B42A2E</Color>
    <Color x:Key="DangerPressedColor">#A4262A</Color>
    <Color x:Key="DangerDisabledColor">#CCCCCC</Color>
    
    <Color x:Key="SecondaryColor">#F3F3F3</Color>
    <Color x:Key="SecondaryHoverColor">#E5E5E5</Color>
    <Color x:Key="SecondaryPressedColor">#D4D4D4</Color>
    <Color x:Key="SecondaryBorderColor">#CCCCCC</Color>
    <Color x:Key="SecondaryHoverBorderColor">#999999</Color>
    <Color x:Key="SecondaryDisabledColor">#F3F3F3</Color>
    <Color x:Key="SecondaryDisabledBorderColor">#DDDDDD</Color>
    
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="SuccessHoverColor">#0E6B0E</Color>
    <Color x:Key="SuccessPressedColor">#0C5A0C</Color>
    
    <Color x:Key="WarningColor">#FF8C00</Color>
    <Color x:Key="WarningHoverColor">#E67E00</Color>
    <Color x:Key="WarningPressedColor">#CC6D00</Color>

    <!-- Focus -->
    <Color x:Key="FocusColor">#0078D4</Color>
    <Color x:Key="FocusBorderColor">#0078D4</Color>

    <!-- Shadows -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="OverlayColor">#80000000</Color>

    <!-- Corner Radius -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <sys:Double x:Key="CornerRadiusSmallValue">4</sys:Double>
    <sys:Double x:Key="CornerRadiusMediumValue">8</sys:Double>
    <sys:Double x:Key="CornerRadiusLargeValue">12</sys:Double>

    <!-- Spacing -->
    <sys:Double x:Key="BaseSpacing">8</sys:Double>
    <sys:Double x:Key="SmallSpacing">4</sys:Double>
    <sys:Double x:Key="LargeSpacing">16</sys:Double>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="SmallControlPadding">8,4</Thickness>
    <Thickness x:Key="LargeControlPadding">16,10</Thickness>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeMedium">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- Font Family -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, system-ui, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- Animation Durations -->
    <Duration x:Key="FastAnimation">0:0:0.1</Duration>
    <Duration x:Key="NormalAnimation">0:0:0.2</Duration>
    <Duration x:Key="SlowAnimation">0:0:0.3</Duration>

    <!-- Border Thickness -->
    <Thickness x:Key="DefaultBorderThickness">1</Thickness>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>

    <!-- Effects -->
    <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270" Color="Black" />

</ResourceDictionary>